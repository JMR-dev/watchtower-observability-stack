# Managed by Ansible (roles/grafana). The telemetry fleet dashboard, from
# provisioning/dashboards/telemetry/, into the Telemetry folder with the
# alerts. Read-only in the UI: change telemetry-fleet.json.j2 and deploy.
apiVersion: 1
providers:
  - name: telemetry
    orgId: 1
    folder: Telemetry
    type: file
    disableDeletion: true
    allowUiUpdates: false
    updateIntervalSeconds: 60
    options:
      path: /etc/grafana/provisioning/dashboards/telemetry
      foldersFromFilesStructure: false
