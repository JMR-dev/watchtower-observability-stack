# Managed by Ansible (roles/edge).
[Unit]
Description=wg-easy (client VPN, wg0 {{ watchtower_tunnel_ip }})
Wants=network-online.target
After=network-online.target
RequiresMountsFor={{ watchtower_data }}

[Container]
Image={{ watchtower_images.wg_easy }}
ContainerName=wg-easy
# wg0 has to be the host's: Caddy binds the tunnel address on it.
Network=host
AddCapability=NET_ADMIN
AddCapability=NET_RAW
# It creates wg0 over netlink and writes iptables rules, which an
# SELinux-confined container may not; the same exception the old single-VM
# design made. The wireguard and nft_masq modules are preloaded, so it needs
# no SYS_MODULE.
SecurityLabelDisable=true
LogDriver=journald
Volume={{ watchtower_data }}/wg-easy:/etc/wireguard
# First start only: wg-easy keeps its settings in its database after that.
Environment=INIT_ENABLED=true
Environment=INIT_USERNAME=admin
Environment=INIT_HOST={{ watchtower_vpn_host }}
Environment=INIT_PORT={{ watchtower_wireguard_port }}
Environment=INIT_IPV4_CIDR={{ watchtower_tunnel_cidr }}
# Split tunnel: peers route only the tunnel range through it.
Environment=INIT_ALLOWED_IPS={{ watchtower_tunnel_cidr }}
Environment=DISABLE_IPV6=true
Secret=wg-easy-password,type=env,target=INIT_PASSWORD
# The UI on loopback; Caddy serves it on :{{ watchtower_ports.edge.wg_easy }} inside the tunnel.
Environment=HOST=127.0.0.1
Environment=PORT={{ watchtower_ports.wg_easy_ui }}
Environment=TRUSTED_PROXIES=127.0.0.1
PodmanArgs=--memory={{ watchtower_memory.wg_easy }}m

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
