# Managed by Ansible (roles/kafka). The image's run script turns KAFKA_*
# variables into server.properties; setting any of them drops all its
# defaults, so everything Kafka needs is here. Nothing secret.
CLUSTER_ID={{ kafka_cluster_id }}
KAFKA_NODE_ID={{ node_index }}
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_CONTROLLER_QUORUM_VOTERS={% for h in groups['nodes'] %}{{ hostvars[h].node_index }}@{{ hostvars[h].mesh_ip }}:{{ watchtower_ports.kafka.controller }}{{ ',' if not loop.last }}{% endfor %}

KAFKA_LISTENERS=PLAINTEXT://{{ mesh_ip }}:{{ watchtower_ports.kafka.broker }},CONTROLLER://{{ mesh_ip }}:{{ watchtower_ports.kafka.controller }}
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://{{ mesh_ip }}:{{ watchtower_ports.kafka.broker }}
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
KAFKA_LOG_DIRS=/var/lib/kafka/data
# Three copies of everything, two in sync to accept a write (Tempo's
# distributors use acks=all).
KAFKA_DEFAULT_REPLICATION_FACTOR=3
KAFKA_MIN_INSYNC_REPLICAS=2
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=3
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=3
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=2
KAFKA_AUTO_CREATE_TOPICS_ENABLE=false
KAFKA_UNCLEAN_LEADER_ELECTION_ENABLE=false
# Tempo writes records up to about 16 MB.
KAFKA_MESSAGE_MAX_BYTES=16000000
KAFKA_REPLICA_FETCH_MAX_BYTES=16000000
KAFKA_LOG_RETENTION_HOURS=24
KAFKA_HEAP_OPTS={{ kafka_heap }}
