#!/usr/sbin/nft -f
# Watchtower host firewall. Managed by Ansible (roles/firewall).
#
# The host layer under the Hetzner Cloud Firewall. It mirrors that firewall
# from the same lists (the cloud stack's breakGlassCidrs and wireguardAllowCidrs,
# handed over in the inventory), so a host stays filtered if the cloud
# firewall is ever detached, and it is the only filter on the private
# network, the mesh and the tunnel. Layers, outside in:
#   1. Hetzner Cloud Firewall: on the proxy only, SSH from the break-glass
#      bastion and UDP 51820; the nodes take nothing on their public
#      addresses
#   2. this ruleset: the same; SSH to the proxy from WireGuard admin peers on
#      the tunnel address (agent peers reach only the ingest listeners), and
#      to a node from the proxy's private address; the
#      mesh transport from the private network; on wg1, everything between
#      nodes but only Caddy's backend ports from the proxy
#   3. fail2ban: per-address SSH bans in its own table, inet f2b-table
#
# Every container uses the host's network (Network=host), so nothing is
# forwarded and the forward chain drops everything.
#
# Only this table: fail2ban and wg-easy keep theirs, and a packet has to get
# through every table's chain on a hook. The file swaps the table in one
# transaction. watchtower-nftables.service loads it, never nftables.service,
# whose reload and stop flush the whole ruleset.
#
#   systemctl reload watchtower-nftables
#   nft --check --file /etc/nftables/watchtower.nft
{% macro cidr_set(name, type, cidrs) %}
    set {{ name }} {
        type {{ type }}
        flags interval
        auto-merge
{% if cidrs %}
        elements = { {{ cidrs | join(', ') }} }
{% endif %}
    }
{% endmacro %}
{% set edge_backends = [
     watchtower_ports.grafana.http,
     watchtower_ports.loki.http,
     watchtower_ports.mimir.http,
     watchtower_ports.tempo['query-frontend'].http,
     watchtower_ports.tempo.distributor.http,
     watchtower_ports.otlp.grpc,
     watchtower_ports.otlp.http] %}
{% set edge_listeners = watchtower_ports.edge.values() | list %}
{% set agent_listeners = [
     watchtower_ports.edge.loki,
     watchtower_ports.edge.mimir,
     watchtower_ports.edge.otlp_grpc,
     watchtower_ports.edge.otlp_http] %}

table inet watchtower
delete table inet watchtower

table inet watchtower {
{{ cidr_set('mesh_nodes', 'ipv4_addr', groups['nodes'] | map('extract', hostvars, 'mesh_ip') | list) }}
{{ cidr_set('mesh_proxy', 'ipv4_addr', groups['proxy'] | map('extract', hostvars, 'mesh_ip') | list) }}
{% if 'proxy' in group_names %}
{{ cidr_set('break_glass_v4', 'ipv4_addr', watchtower_break_glass_cidrs | reject('search', ':') | list) }}
{{ cidr_set('break_glass_v6', 'ipv6_addr', watchtower_break_glass_cidrs | select('search', ':') | list) }}
{{ cidr_set('wireguard_v4', 'ipv4_addr', watchtower_wireguard_cidrs | reject('search', ':') | list) }}
{{ cidr_set('wireguard_v6', 'ipv6_addr', watchtower_wireguard_cidrs | select('search', ':') | list) }}
{{ cidr_set('vpn_agents', 'ipv4_addr', [watchtower_agent_cidr]) }}
{% endif %}
    chain input {
        type filter hook input priority filter; policy drop;

        ct state established,related accept
        # A host's traffic to its own mesh address arrives on lo too.
        iif "lo" accept
        ct state invalid drop
{% if 'proxy' in group_names %}

        # Agent peers (services shipping telemetry, docs/client-telemetry.md)
        # go to a chain of their own, which ends in drop, so no rule here
        # can admit them to anything else. CI checks it stays right here.
        ip saddr @vpn_agents jump agent_peers
{% endif %}

        # DHCP replies: both networks lease their IPv4 addresses.
        udp sport 67 udp dport 68 accept

        # The ICMPv6 that IPv6 needs to work at all (neighbour discovery, path
        # MTU) is never rate-limited; pings are.
        icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem, mld-listener-query, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } accept
        icmpv6 type echo-request limit rate 20/second accept
        icmp type echo-request limit rate 20/second accept

        # The mesh's transport, from the private network only.
        ip saddr {{ watchtower_private_cidr }} udp dport {{ watchtower_mesh_port }} accept
{% if 'nodes' in group_names %}

        # Over the mesh: the other nodes reach everything (rings, gossip,
        # Kafka, etcd, Postgres, Patroni); the proxy only what Caddy proxies
        # to and health-checks.
        iifname "wg1" ip saddr @mesh_nodes accept
        iifname "wg1" ip saddr @mesh_proxy tcp dport { {{ edge_backends | join(', ') }} } accept

        # SSH only from the proxy, over the private network: Ansible and
        # people both jump through it. The fib check takes the address only
        # from the interface it routes back through, so it can't be spoofed
        # on the public one.
{% for ip in groups['proxy'] | map('extract', hostvars, 'private_ip') %}
        ip saddr {{ ip }} tcp dport 22 fib saddr . iif oif exists accept
{% endfor %}
{% endif %}
{% if 'proxy' in group_names %}

        # WireGuard peers to wg-easy.
        ip saddr @wireguard_v4 udp dport {{ watchtower_wireguard_port }} accept
        ip6 saddr @wireguard_v6 udp dport {{ watchtower_wireguard_port }} accept

        # Admin peers (agents never get here), through the tunnel, to Caddy
        # and SSH on the tunnel address and nothing else.
        iifname "wg0" ip daddr {{ watchtower_tunnel_ip }} tcp dport { {{ (edge_listeners + [22]) | join(', ') }} } accept

        # SSH on the public address from the break-glass bastion only; the
        # deploy and people come in over the tunnel. No rate limit: one
        # shared budget would let a scanner lock break glass out. fail2ban
        # bans per address instead.
        ip saddr @break_glass_v4 tcp dport 22 accept
        ip6 saddr @break_glass_v6 tcp dport 22 accept
{% endif %}

        limit rate 5/minute log prefix "nft-drop-input: " level info
        counter drop
    }

{% if 'proxy' in group_names %}
    # Agent peers reach Caddy's ingest listeners through the tunnel and
    # nothing else: no SSH, Grafana, query API or wg-easy. Two rules at the
    # end, so the log's rate limit never decides whether a packet is dropped.
    chain agent_peers {
        iifname "wg0" ip daddr {{ watchtower_tunnel_ip }} tcp dport { {{ agent_listeners | join(', ') }} } accept
        limit rate 5/minute log prefix "nft-agent-drop: " level info
        counter drop
    }

{% endif %}
    chain forward {
        type filter hook forward priority filter; policy drop;

        limit rate 5/minute log prefix "nft-drop-forward: " level info
        counter drop
    }
}
