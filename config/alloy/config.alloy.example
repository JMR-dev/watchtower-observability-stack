// Grafana Alloy (v1.21.2) for a service that ships its telemetry to
// watchtower; docs/client-telemetry.md is the contract. The host must be one
// of watchtower's agent peers (its config is in Secret Manager,
// watchtower-observe/wireguard-<peer>-peer): watchtower.jasonmross.dev
// resolves to 10.8.0.1, inside the tunnel, and nowhere else.
//
// Agents may only write, and only into the shared tenant jasonmross: Caddy
// overwrites X-Scope-OrgID for them, so the headers below only say so.
// Everything is TLS with a public certificate, so no `insecure` settings.
//
// Replace SERVICE, HOST and ENV (production or disposable). No OTLP receiver
// in v1: nothing of ours emits traces yet (docs/client-telemetry.md).
//
// Nothing on the server scrubs: loki.process "scrub" is all that stands
// between these logs and storage. stage.replace rewrites each capture group
// with `replace` and nothing else (a regex without one changes nothing), so
// every rule captures exactly the part to hide. scripts/check-alloy-scrub.sh
// runs the rules against testdata/scrub.log and scrub.caddy.log; copy them
// with this file and add your service's own lines.

logging {
	level  = "info"
	format = "logfmt"
}

// ============================================================
// LOGS  ──► Loki
// ============================================================

loki.source.journal "system" {
	forward_to    = [loki.process.scrub.receiver]
	relabel_rules = loki.relabel.journal.rules
	labels        = {service = "SERVICE", host = "HOST", env = "ENV"}
}

loki.relabel "journal" {
	forward_to = []

	// conmon splits a long line into several journal entries and marks all
	// but the last. Drop those, so no piece of a long record (an audit log
	// with headers in it) ships out of context; a JSON pipeline drops the
	// last piece as malformed.
	rule {
		source_labels = ["__journal_container_partial_message"]
		regex         = "true"
		action        = "drop"
	}

	rule {
		source_labels = ["__journal__systemd_unit"]
		target_label  = "unit"
	}

	// A rootless (user) unit's name is in _SYSTEMD_USER_UNIT; its
	// _SYSTEMD_UNIT is just user@<uid>.service.
	rule {
		source_labels = ["__journal__systemd_user_unit"]
		regex         = "(.+)"
		target_label  = "unit"
	}

	rule {
		source_labels = ["__journal_container_name"]
		target_label  = "container"
	}

	rule {
		source_labels = ["__journal_priority_keyword"]
		target_label  = "level"
	}
}

// scrub: begin (scripts/check-alloy-scrub.sh tests what is between the markers)
loki.process "scrub" {
	forward_to = [loki.write.watchtower.receiver]

	// Caddy logs one JSON object a line. One that doesn't parse is the last
	// piece of a line conmon split (the relabel rule drops the others): the
	// tail of a record with headers in it, cut off from the keys the rules
	// below look for. It never ships. First, since a redacted line is no
	// longer JSON.
	stage.match {
		selector = "{container=\"caddy\"}"

		stage.json {
			expressions    = {logger = ""}
			drop_malformed = true
		}
	}

	// Coraza's audit records hold whole requests: headers, cookies, bodies.
	stage.drop {
		expression          = `\\*"transaction\\*"\s*:\s*\{`
		drop_counter_reason = "audit_record"
	}

	// A WAF rule match quotes what it matched as [data "..."]: a visitor's
	// form value, header or cookie. The whole field goes, first, so a quoted
	// "Cookie: ..." can't set off a rule below that cuts to the end of the
	// line. Coraza writes [severity "..."] right after it, once a line, so
	// the greedy match ends at the real field even when the data holds a
	// lookalike. A rule with several matches adds [msg_match_N "..."]
	// [data_match_N "..."] at the end of the line. Inside Caddy's JSON the
	// quotes are \".
	stage.replace {
		expression = `(\[data \\?".*\\?"\] ?)\[severity `
		replace    = ""
	}

	stage.replace {
		expression = `(\[msg_match_\d+ \\?".*\\?"\])`
		replace    = ""
	}

	// Matched data in a shape those two didn't expect: drop the line.
	// fail2ban reads the journal on the host, so a ban doesn't depend on it.
	stage.drop {
		expression          = `\[data(?:_match_\d+)? \\?"`
		drop_counter_reason = "waf_data"
	}

	// JWTs, and bearer tokens wherever they appear.
	stage.replace {
		expression = `\b(eyJ[A-Za-z0-9_-]{5,}\.[A-Za-z0-9_-]{5,}\.[A-Za-z0-9_-]*)`
		replace    = "[REDACTED-JWT]"
	}

	stage.replace {
		expression = `(?i)\bbearer\s+([A-Za-z0-9._~+/=-]{8,})`
		replace    = "[REDACTED-CREDENTIAL]"
	}

	// SSH key fingerprints, which name a person's key. Upper case only: a
	// lower-case sha256: is an image digest.
	stage.replace {
		expression = `\b(?:SHA256|MD5):([A-Za-z0-9+/=:]{16,})`
		replace    = "[REDACTED-FINGERPRINT]"
	}

	// wg's errors quote the line or key they choke on, and that can be a
	// private key.
	stage.replace {
		expression = `(?:Key is not the correct length or format|Line unrecognized): \x60(.+)`
		replace    = "[REDACTED-SECRET]"
	}

	// A JSON field whose name holds one of these goes whole, name kept, the
	// value read the way it is written: an array of strings (Caddy logs every
	// header as "Name":["value"]) or one more deeply nested, an object, a
	// string with escaped quotes, a single-quoted string (Python's repr), a
	// number or other bare word. What doesn't close, or nests deeper than
	// these, goes to the end of the line, so a closing bracket in a value or a
	// line cut short never ships the rest.
	stage.replace {
		expression = `(?i)["'][\w.-]*authorization[\w.-]*["']\s*[:=]\s*(\[(?:"(?:[^"\\]|\\.)*"|\[(?:"(?:[^"\\]|\\.)*"|[^"\[\]])*\]|[^"\[\]])*\]|\{(?:"(?:[^"\\]|\\.)*"|\{(?:"(?:[^"\\]|\\.)*"|[^"{}])*\}|[^"{}])*\}|"(?:[^"\\]|\\.)*"|'(?:[^'\\]|\\.)*'|[^\s,}\]\[{"'\\][^\s,}\]\\]*|.*)`
		replace    = "[REDACTED-CREDENTIAL]"
	}

	stage.replace {
		expression = `(?i)["'][\w.-]*cookie[\w.-]*["']\s*[:=]\s*(\[(?:"(?:[^"\\]|\\.)*"|\[(?:"(?:[^"\\]|\\.)*"|[^"\[\]])*\]|[^"\[\]])*\]|\{(?:"(?:[^"\\]|\\.)*"|\{(?:"(?:[^"\\]|\\.)*"|[^"{}])*\}|[^"{}])*\}|"(?:[^"\\]|\\.)*"|'(?:[^'\\]|\\.)*'|[^\s,}\]\[{"'\\][^\s,}\]\\]*|.*)`
		replace    = "[REDACTED-COOKIE]"
	}

	// Secrets by key name (DB_PASSWORD, X-API-Key, "session", privateKey, ...).
	// pass, otp and auth are the whole name or its last part (db_pass, x-auth),
	// never part of a word (bypass, authenticated).
	stage.replace {
		expression = `(?i)["'](?:[\w.-]*(?:password|passwd|passphrase|pwd|secret|token|api[_-]?key|private[_-]?key|preshared[_-]?key|session|credential)[\w.-]*|(?:[\w.-]*[_.-])?(?:pass|t?otp|o?auth))["']\s*[:=]\s*(\[(?:"(?:[^"\\]|\\.)*"|\[(?:"(?:[^"\\]|\\.)*"|[^"\[\]])*\]|[^"\[\]])*\]|\{(?:"(?:[^"\\]|\\.)*"|\{(?:"(?:[^"\\]|\\.)*"|[^"{}])*\}|[^"{}])*\}|"(?:[^"\\]|\\.)*"|'(?:[^'\\]|\\.)*'|[^\s,}\]\[{"'\\][^\s,}\]\\]*|.*)`
		replace    = "[REDACTED-SECRET]"
	}

	// The same inside a JSON string: a log line that quotes a JSON body, with
	// \" for its quotes. Deeper quoting than that goes to the end of the line.
	stage.replace {
		expression = `(?i)\\+"(?:[\w.-]*(?:password|passwd|passphrase|pwd|secret|token|api[_-]?key|private[_-]?key|preshared[_-]?key|session|credential|authorization|cookie)[\w.-]*|(?:[\w.-]*[_.-])?(?:pass|t?otp|o?auth))\\+"\s*:\s*(\[(?:\\"(?:\\\\\\"|\\\\|\\[^"\\]|[^"\\])*\\"|[^"\\\]])*\]|\{(?:\\"(?:\\\\\\"|\\\\|\\[^"\\]|[^"\\])*\\"|[^"\\{}])*\}|\\"(?:\\\\\\"|\\\\|\\[^"\\]|[^"\\])*\\"|[^\s,}\]\[{"'\\][^\s,}\]\\]*|.*)`
		replace    = "[REDACTED-SECRET]"
	}

	// Authorization and cookie headers as `Name: value`, under any name that
	// holds one, to the end of the line.
	stage.replace {
		expression = `(?i)[\w.-]*authorization\s*[:=]\s*([^\r\n]+)`
		replace    = "[REDACTED-CREDENTIAL]"
	}

	stage.replace {
		expression = `(?i)[\w.-]*cookies?\s*[:=]\s*([^\r\n]+)`
		replace    = "[REDACTED-COOKIE]"
	}

	// key=value or key: value, quoted (quotes escaped inside it) or bare. A
	// bare one goes up to the next blank, & or closing quote, so a comma or a
	// semicolon in it (?password=a,b;c in a uri) doesn't ship the rest; \" is
	// part of the value, as in a JSON string.
	//
	// The first two alternatives have no capture group, so they hide nothing:
	// they match first and take these out of the rule's reach. systemd's
	// `session-3.scope: Deactivated` names a unit, and sudo's `TTY=x ; PWD=/y ;`
	// a directory. Any other PWD is a password's short name.
	stage.replace {
		expression = `(?i)session-\w+\.scope:|(?-i:\bTTY=[^\s;=:]+ ; PWD=/[^\s;=:]* ;)|[\w.-]*(?:password|passwd|passphrase|pwd|secret|token|api[_-]?key|private[_-]?key|preshared[_-]?key|session|credential)[\w.-]*\s*[=:]\s*("(?:[^"\\]|\\.)*"|".*|'(?:[^'\\]|\\.)*'|'.*|(?:\\.|[^\s&"'\\])(?:\\.|[^\s&"\\])*)`
		replace    = "[REDACTED-SECRET]"
	}

	// Short names that are also ordinary words: only with an equals sign, so
	// `auth: ok` and `tests pass: 5` stay. `otp: 123456` gets through.
	stage.replace {
		expression = `(?i)\b(?:[\w.-]*[_.-])?(?:pass|t?otp|o?auth)\s*=\s*("(?:[^"\\]|\\.)*"|".*|'(?:[^'\\]|\\.)*'|'.*|(?:\\.|[^\s&"'\\])(?:\\.|[^\s&"\\])*)`
		replace    = "[REDACTED-SECRET]"
	}

	// Other credentials in query strings.
	stage.replace {
		expression = `(?i)[?&](?:code|state|key|sig|signature|x-amz-signature|x-amz-credential|x-goog-signature|x-goog-credential)=((?:\\.|[^&\s"#\\])+)`
		replace    = "[REDACTED-SECRET]"
	}

	// Passwords in connection strings: scheme://user:PASSWORD@host.
	stage.replace {
		expression = `(?i)\b[a-z][a-z0-9+.-]*://[^/\s:@]*:([^@\s/]+)@`
		replace    = "[REDACTED-SECRET]"
	}

	// Email addresses, URL-encoded (%40) too.
	stage.replace {
		expression = `\b([A-Za-z0-9._%+-]+(?:@|%40)[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,})\b`
		replace    = "[REDACTED-EMAIL]"
	}

	// OS Login usernames: an email address in a domain in use
	// (user_gmail_com), or a service account's number (sa_<id>).
	stage.replace {
		expression = `\b([a-z0-9][a-z0-9._-]*_(?:gmail_com|googlemail_com|jasonmross_dev))\b`
		replace    = "[REDACTED-USER]"
	}

	stage.replace {
		expression = `\b(sa_\d{10,})\b`
		replace    = "[REDACTED-USER]"
	}

	// IPv4 addresses, whole. A four-part version number goes too.
	stage.replace {
		expression = `\b((?:\d{1,3}\.){3}\d{1,3})\b`
		replace    = "[REDACTED-IP]"
	}

	// IPv6 addresses: eight groups, or compressed with "::" and a group after
	// it or two before it, so never a clock time or a Rust path (db::query).
	// Then the same after a colon (client:2001:db8::1), with three groups or
	// more.
	stage.replace {
		expression = `(?:^|[^\w:.])((?:[0-9A-Fa-f]{1,4}:){7}[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}(?::[0-9A-Fa-f]{1,4}){0,6})?::[0-9A-Fa-f]{1,4}(?::[0-9A-Fa-f]{1,4}){0,6}|[0-9A-Fa-f]{1,4}(?::[0-9A-Fa-f]{1,4}){1,6}::)`
		replace    = "[REDACTED-IP6]"
	}

	stage.replace {
		expression = `:((?:[0-9A-Fa-f]{1,4}:){2,6}:(?:[0-9A-Fa-f]{1,4}(?::[0-9A-Fa-f]{1,4}){0,5})?|(?:[0-9A-Fa-f]{1,4}:){1,6}:[0-9A-Fa-f]{1,4}(?::[0-9A-Fa-f]{1,4}){1,5})`
		replace    = "[REDACTED-IP6]"
	}

	// MAC addresses.
	stage.replace {
		expression = `\b((?:[0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2})\b`
		replace    = "[REDACTED-MAC]"
	}

	// Card numbers: 15 or 16 digits starting 2 to 6, unbroken or in dashed
	// fours. Never an epoch time (they start with 1 until 2033) or a list of
	// ports; a number typed with spaces gets through.
	stage.replace {
		expression = `\b([2-6]\d{14,15}|[2-6]\d{3}(?:-\d{4}){3})\b`
		replace    = "[REDACTED-PAN]"
	}

	// UUIDs, which name users and their records.
	stage.replace {
		expression = `\b([0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12})\b`
		replace    = "[REDACTED-UUID]"
	}

	// A secret in a shape none of the rules caught: drop the line.
	stage.drop {
		expression          = `(?i)[\w.-]*(?:password|passwd|secret|ssn|cvv|cvc)[\w.-]*\s*[:=]\s*[^\s\["']`
		drop_counter_reason = "secret"
	}
}
// scrub: end

loki.write "watchtower" {
	endpoint {
		url     = "https://watchtower.jasonmross.dev:3100/loki/api/v1/push"
		headers = {"X-Scope-OrgID" = "jasonmross"}

		// Keep retrying through a watchtower restart or reboot (about a
		// day at most); the journal position waits meanwhile.
		max_backoff_period  = "5m"
		max_backoff_retries = 300
		retry_on_http_429   = true
	}
}

// ============================================================
// METRICS  ──► Mimir
// ============================================================

prometheus.exporter.unix "host" {
	set_collectors = ["cpu", "diskstats", "filesystem", "loadavg", "meminfo", "netdev", "pressure", "stat", "time", "uname", "vmstat"]

	// The exporter's own exclusions, and each login's /run/user/<uid>: a
	// label with an OS Login uid in it otherwise.
	filesystem {
		mount_points_exclude = "^/(dev|proc|run/credentials/.+|run/user/.+|sys|var/lib/docker/.+|var/lib/containers/storage/.+)($|/)"
	}
}

prometheus.exporter.self "alloy" { }

discovery.relabel "unix" {
	targets = prometheus.exporter.unix.host.targets

	rule {
		target_label = "job"
		replacement  = "integrations/unix"
	}
}

discovery.relabel "alloy" {
	targets = prometheus.exporter.self.alloy.targets

	rule {
		target_label = "job"
		replacement  = "alloy"
	}
}

prometheus.scrape "local" {
	targets         = array.concat(discovery.relabel.unix.output, discovery.relabel.alloy.output)
	forward_to      = [prometheus.remote_write.watchtower.receiver]
	scrape_interval = "60s"
}

prometheus.remote_write "watchtower" {
	endpoint {
		url     = "https://watchtower.jasonmross.dev:8080/api/v1/push"
		headers = {"X-Scope-OrgID" = "jasonmross"}
	}
	external_labels = {service = "SERVICE", host = "HOST", env = "ENV"}
}
